# --- your photos -----------------------------------------------------------
# The folder on THIS machine that holds the photos, inside Nextcloud's data
# directory: <nextcloud data>/<user>/files/<folder>. Mounted read-only; nothing
# is ever deleted through it.
PHOTOS_DIR=/var/www/nextcloud/data/alice/files/Photos
# The user that can read those files. 33 is www-data on Debian/Ubuntu and in
# the official Nextcloud image.
PUID=33
PGID=33

# --- Nextcloud: deletes go to its Deleted files, restorable -----------------
# Leave NC_BASE empty to browse without deleting.
NC_BASE=https://cloud.example.com
NC_USER=alice
# The same folder as PHOTOS_DIR, as Nextcloud names it (relative to the user's files)
NC_PREFIX=Photos

# --- the model --------------------------------------------------------------
# Any Ollama-compatible server. With the bundled one (--profile ollama), keep
# the default and run once:  docker compose exec ollama ollama pull qwen3-vl:8b
OLLAMA_URL=http://ollama:11434
MODEL=qwen3-vl:8b
# Only if your server wants a bearer token: a file path inside the container.
# OLLAMA_TOKEN_FILE=/data/ollama.token

# --- sign-in ----------------------------------------------------------------
# password: set it with  docker compose exec web python -m photosweep.passwd
# header:   a proxy that signs users in (Authelia, Authentik, Tailscale serve)
#           passes the name in AUTH_HEADER; only names in OPERATORS get in.
#           Use only when nothing but that proxy can reach the port.
AUTH_MODE=password
# AUTH_HEADER=Remote-User
# OPERATORS=alice
SESSION_HOURS=12
# Your reverse proxy's address, so HTTPS is recognised and cookies are Secure.
# FORWARDED_ALLOW_IPS=172.18.0.1

# PORT=8087
# LOG_LEVEL=INFO
